# Copy this file to .env and paste your keys after the = sign (no quotes, no spaces). .env is git- and docker-ignored.
OPENAI_API_KEY=

# Optional. Default is gpt-6.1-sol. Cheaper: gpt-5.4-mini. Must be a vision model (PDF pages are sent as images).
OPENAI_MODEL=

# Azure OpenAI v1 endpoint (OpenAI SDK reads this). OPENAI_MODEL is the Azure deployment name.
OPENAI_BASE_URL=

# Optional Claude key. If both keys are set, Claude is used unless COCKPIT_LLM=openai.
ANTHROPIC_API_KEY=
COCKPIT_LLM=

# ---- Connectors (all optional; leave blank to use the bundled sample data) ----
# PO book: seed | file | sheets | auto (default: sheets if GOOGLE_SHEET_ID is set, else fixtures/po_book.xlsx)
# COCKPIT_PO_SOURCE=
# COCKPIT_PO_BOOK=
# Google Sheet id from its URL. Share it "anyone with the link can view", or set a service-account JSON file.
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=
# Gmail over IMAP: Google account > Security > 2-Step Verification > App passwords
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# Outlook / Microsoft 365 via Graph: Entra app registration with the Mail.Read application permission
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_MAILBOX=
# Slack incoming webhook (https://hooks.slack.com/services/...). Without it, messages are previews only.
# SLACK_WEBHOOK_URL=
# COCKPIT_SLACK_ALERTS=needs_review,rejected,failed,held_mail
# COCKPIT_DIGEST_TIME=18:00
# COCKPIT_PUBLIC_URL=http://localhost:8000
